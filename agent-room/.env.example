AGENT_ROOM_PORT=3101
AGENT_ROOM_HOST=127.0.0.1
AGENT_ROOM_DB=.agent-room/room.sqlite
AGENT_ROOM_REPO_ROOT=..

# Loopback rejimida ixtiyoriy. LAN yoki Railway uchun majburiy qiling.
AGENT_ROOM_TOKEN=

# Supervisor xavfsiz defaultlari
AGENT_ROOM_SUPERVISOR_MODE=plan
AGENT_ROOM_ALLOW_WRITES=false
AGENT_ROOM_POLL_MS=2500
AGENT_ROOM_AGENT_TIMEOUT_MS=900000
AGENT_ROOM_MAX_BUDGET_USD=2
# Faqat CLI keychain/login ishlamasa yoqing; defaultda API key envlar child agentga berilmaydi.
AGENT_ROOM_FORWARD_AUTH_ENV=false

# Ixtiyoriy CLI override
AGENT_ROOM_CLAUDE_COMMAND=claude
AGENT_ROOM_KIMI_COMMAND=kimi
AGENT_ROOM_CODEX_COMMAND=codex
